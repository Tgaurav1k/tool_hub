# Copy this file to backend/.env and fill in values
# NEVER commit .env to version control

# Database — PostgreSQL (example). Copy to backend/.env and use your real URL.
# Optional: ?sslmode=require for managed Postgres that enforces TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Auth
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Server
PORT=4000
NODE_ENV=development

# SuperAdmin seed credentials (two accounts).
# #1 = primary. #2 = hidden from the activity log (no login/logout/tool_launch rows written for it).
SUPERADMIN_EMAIL1=superadmin@toolhub.internal
SUPERADMIN_PASSWORD1=ChangeThisOnFirstLogin!
SUPERADMIN_EMAIL2=superadmin2@toolhub.internal
SUPERADMIN_PASSWORD2=ChangeThisOnFirstLogin!
# Role stored in DB for those users — must be: superadmin
SUPERADMIN_ROLE=superadmin
SUPERADMIN_IMAGE=https://example.com/superadmin-avatar.png

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5001,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Public base URL of the frontend — used to build the password reset link in emails.
APP_URL=http://localhost:3000

# Login rate limit (per email): failed attempts allowed per window before lockout.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=10

# Password reset link lifetime (jsonwebtoken duration).
PASSWORD_RESET_EXPIRES_IN=1h

# Docker Postgres (used by deploy.ps1 / docker-compose)
DB_USER=tools_user
DB_PASSWORD=change-me
DB_NAME=tools

# Deploy target (deploy.ps1). DEPLOY_HOST is also used by prisma/seed.ts for tool URLs.
DEPLOY_HOST=your.server.ip
DEPLOY_PORT=1002
DEPLOY_USERNAME=deploy-user
DEPLOY_SSH_KEY=C:\path\to\your\private_key

# Dev frontend port (Vite)
FRONTEND_PORT=5001

# SMTP for password reset and account emails
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=no-reply@example.com

# Linked external tool sync (optional)
LINKED_TOOL_API_BASE_URL=https://linked-tool.example.com
LINKED_TOOL_SUPERADMIN_USERNAME=change-me
LINKED_TOOL_SUPERADMIN_PASSWORD=change-me
